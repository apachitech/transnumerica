# ==============================================================================
# TRANSNUMERICA — PRODUCTION ENVIRONMENT CONFIGURATION (VERCEL & SUPABASE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & DOMAIN
# ------------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://transnumerica.cd

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE & CONNECTION POOLING (PORT 6543 vs PORT 5432)
# ------------------------------------------------------------------------------
# Transaction Pooler (Port 6543 - Supavisor) for Vercel Serverless Functions:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection (Port 5432) for Prisma Migrations & Schema Deployment:
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 3. SUPABASE API & STORAGE BUCKETS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Buckets (configure in Supabase Storage dashboard):
# transnumerica-media (Public: yes, for CMS & public photos)
# transnumerica-kyc (Public: no, for driver IDs & licenses)
# transnumerica-exports (Public: no, for audit & financial CSVs)
SUPABASE_STORAGE_BUCKET_MEDIA="transnumerica-media"
SUPABASE_STORAGE_BUCKET_KYC="transnumerica-kyc"

# ------------------------------------------------------------------------------
# 4. ADMIN RBAC & NETWORK ACCESS
# ------------------------------------------------------------------------------
# IP Allowlist: include your admin IP/subnets and loopback addresses
ADMIN_IP_ALLOWLIST="127.0.0.1,::1,192.168.43.221,192.168.43.1,192.168.43.0/24"

# Super Admin Initial Account
SUPER_ADMIN_EMAIL=superadmin@transnumerica.cd
SUPER_ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION_Transnumerica@RDC2026!"
SUPER_ADMIN_PHONE=+243810000001
SUPER_ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Standard Admin Initial Password
ADMIN_PASSWORD="CHANGE_ME_IN_PRODUCTION_AdminPass2026!"

# ------------------------------------------------------------------------------
# 5. SECURITY & SECRETS
# ------------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_64_character_hex_secret_here
ADMIN_MASTER_KEY=generate_another_random_64_character_hex_key_here

# ------------------------------------------------------------------------------
# 6. MOBILE MONEY GATEWAYS (RDC)
# ------------------------------------------------------------------------------
MPESA_API_KEY=""
MPESA_API_SECRET=""
AIRTEL_MONEY_CLIENT_ID=""
AIRTEL_MONEY_CLIENT_SECRET=""
ORANGE_MONEY_AUTH_HEADER=""

